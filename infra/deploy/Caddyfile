# TLS with automatic certificates for DOMAIN (an internal CA for localhost).
# No access log: visitors' IP addresses are not written anywhere.
{$DOMAIN} {
	encode zstd gzip

	# Material files and images: written once under their content hash.
	handle_path /files/* {
		root * /srv/files
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The instance's static site (landing pages) wins over the app:
	# `/roadmap` is site/roadmap.html, `/` is site/index.html.
	@page file {
		root /srv/site
		try_files {path}.html {path}index.html
	}
	handle @page {
		root * /srv/site
		try_files {path}.html {path}index.html
		header Cache-Control no-cache
		file_server
	}
	@static {
		not path */
		file {
			root /srv/site
			try_files {path}
		}
	}
	handle @static {
		root * /srv/site
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy app:3000
	}
}
