# .env of a deployment (mode 0600). `chromatis deploy` writes it from the
# instance's configuration and secret store; a school can fill it in by hand.
COMPOSE_PROJECT_NAME=studyluma
IMAGE=ghcr.io/chromatisgit/studyluma:0.3.0
DOMAIN=studyluma.example.org
# 32+ random characters each, letters and digits only (they go into URLs):
#   openssl rand -hex 24
POSTGRES_PASSWORD=
DATABASE_OWNER_PASSWORD=
DATABASE_AUTH_PASSWORD=
DATABASE_RUNTIME_PASSWORD=
# Optional
# DATABASE_POOL_SIZE=5
# HTTP_PORT=80
# HTTPS_PORT=443
# BACKUP_TARGET=u123456@u123456.your-storagebox.de:studyluma
# BACKUP_KEEP=14
