{
  "name": "@platform/framework",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd demo-app dev",
    "build": "bun run --cwd demo-app build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && bun run --cwd demo-app typecheck",
    "dbInit": "bun run infra/scripts/dbDocker.ts reset && bun run infra/scripts/dbInit.ts",
    "dbUpdate": "bun run infra/scripts/dbDocker.ts start && bun run infra/scripts/dbUpdate.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./component": "./src/component.ts",
    "./db": "./src/db.ts",
    "./runtime": "./src/runtime.ts",
    "./offline": "./src/offline.ts",
    "./styles": "./src/ui/style/consumer.css"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "motion": ">=12.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-router": ">=7.0.0",
    "sonner": ">=1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@neondatabase/serverless": "^1.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "argon2": "^0.41.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "sonner": "^1.7.4",
    "tw-animate-css": "^1.2.5",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "postgres": "^3.4.8",
    "react-router": "7.14.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "zod": "^3.24.0"
  }
}
