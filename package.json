{
  "name": "@chromatis/base",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "chromatis": "./infra/scripts/chromatis.ts"
  },
  "scripts": {
    "dev": "bun test --watch",
    "build": "bun run typecheck",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run db:check && bun run security:check && bun run test",
    "fix": "eslint . --fix && prettier . --write && bun run check",
    "test": "bun test",
    "lint": "eslint . --max-warnings 0 --report-unused-disable-directives",
    "typecheck": "tsc --noEmit && tsc --noEmit -p infra/scripts",
    "format:check": "prettier . --check",
    "db:check": "bun run infra/scripts/dbCheckGeneratedMigrations.ts",
    "db": "bun run infra/scripts/db.ts",
    "security": "bun run infra/scripts/security.ts",
    "security:check": "bun run infra/scripts/security.ts check",
    "security:describe": "bun run infra/scripts/security.ts describe",
    "security:audit": "bun run infra/scripts/security.ts audit"
  },
  "exports": {
    "./auth": "./src/auth.ts",
    "./config": "./src/config.ts",
    "./database": "./src/database.ts",
    "./dev": "./src/dev.ts",
    "./db-migrations": "./infra/scripts/dbMigrations.ts",
    "./errors": "./src/errors.ts",
    "./log": "./src/log.ts",
    "./module": "./src/module.ts",
    "./request-boundary": "./src/request-boundary.ts",
    "./runtime": "./src/runtime.ts",
    "./secrets": "./src/secrets.ts",
    "./stateful": "./src/stateful.ts",
    "./stateful/bun": "./src/stateful/bun.ts",
    "./stateful/cloudflare": "./src/stateful/cloudflare.ts",
    "./stateful/testing": "./src/stateful/testing.ts",
    "./stateful/workerd": "./src/stateful/workerd.ts",
    "./testing": "./src/testing.ts",
    "./test-preload": "./src/test-preload.ts",
    "./virtual-modules": {
      "types": "./src/virtual-modules.d.ts"
    },
    "./styles": "./src/ui/style/index.css",
    "./ui": "./src/index.ts",
    "./vite": "./src/vite.js",
    "./server-hook": "./src/server.ts",
    "./infra/tsconfig": "./infra/tsconfig.base.json",
    "./infra/eslint": {
      "types": "./infra/eslint.config.base.d.ts",
      "default": "./infra/eslint.config.base.js"
    },
    "./infra/pwa/manifest": "./infra/pwa/manifest.base.json"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-router": ">=7.0.0"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@react-router/dev": "^7.0.0",
    "smol-toml": "^1.3.4",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.0.0",
    "wrangler": "4.151.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@neondatabase/serverless": "^1.0.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.17.0",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "lucide-react": "^1.7.0",
    "miniflare": "4.20260515.0",
    "postgres": "^3.4.8",
    "prettier": "^3.6.2",
    "react-router": "7.14.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
