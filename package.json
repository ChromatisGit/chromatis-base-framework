{
  "name": "@chromatis/base",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun test --watch",
    "build": "bun run typecheck",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run config:check && bun run db:check && bun run test",
    "fix": "eslint . --fix && prettier . --write && bun run check",
    "test": "bun test",
    "lint": "eslint . --max-warnings 0 --report-unused-disable-directives",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier . --check",
    "config:check": "bun run infra/scripts/config.ts",
    "db:check": "bun run infra/scripts/dbCheckGeneratedMigrations.ts",
    "doctor": "bun run infra/scripts/doctor.ts",
    "config": "bun run infra/scripts/config.ts",
    "secret": "bun run infra/scripts/secret.ts",
    "db": "bun run infra/scripts/db.ts",
    "deploy": "bun run infra/scripts/deploy.ts"
  },
  "exports": {
    "./auth": "./src/auth.ts",
    "./config": "./src/config.ts",
    "./database": "./src/database.ts",
    "./db-migrations": "./infra/scripts/dbMigrations.ts",
    "./errors": "./src/errors.ts",
    "./log": "./src/log.ts",
    "./request-boundary": "./src/request-boundary.ts",
    "./runtime": "./src/runtime.ts",
    "./secrets": "./src/secrets.ts",
    "./styles": "./src/ui/style/index.css",
    "./styles/reference-theme": "./src/ui/style/reference-theme.css",
    "./ui": "./src/index.ts",
    "./vite": "./src/vite.ts",
    "./infra/tsconfig": "./infra/tsconfig.base.json",
    "./infra/eslint": {
      "types": "./infra/eslint.config.base.d.ts",
      "default": "./infra/eslint.config.base.js"
    },
    "./infra/pwa/manifest": "./infra/pwa/manifest.base.json"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-router": ">=7.0.0"
  },
  "dependencies": {
    "smol-toml": "^1.3.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@eslint/js": "^9.0.0",
    "@neondatabase/serverless": "^1.0.2",
    "@react-router/dev": "^7.0.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "lucide-react": "^1.7.0",
    "postgres": "^3.4.8",
    "prettier": "^3.6.2",
    "react-router": "7.14.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.0.0",
    "zod": "^3.24.0"
  }
}
